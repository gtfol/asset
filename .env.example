# Optional hosted PostgreSQL (e.g. a dedicated Supabase project). Never expose to clients.
DATABASE_URL=
PORT=4317
HOST=127.0.0.1
APP_ORIGIN=http://localhost:4317
# Local embedded PostgreSQL persistence; ignored, never committed.
DATA_DIR=.data/postgres
# Generate independently: openssl rand -hex 32. Required only for Plaid token encryption.
TOKEN_ENCRYPTION_KEY=
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_WEBHOOK_URL=
# HTTPS Universal Link registered in Plaid; required for native bank OAuth.
PLAID_IOS_REDIRECT_URI=
# Production remains disabled in code in this release.
