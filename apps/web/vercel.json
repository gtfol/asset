{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "server/{migrations/*.sql,certs/*.crt}"
    }
  },
  "crons": [{ "path": "/api/internal/plaid-worker", "schedule": "* * * * *" }],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/plaid/oauth", "destination": "/index.html" }
  ]
}
