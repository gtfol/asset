# Optional hosted PostgreSQL (e.g. a dedicated Supabase project). Never expose to clients.
DATABASE_URL=
PORT=4317
HOST=127.0.0.1
# Vercel production: https://asset.gtfol.dev
APP_ORIGIN=http://localhost:4317
# Google OAuth Web application credentials; keep the secret on the server.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local embedded PostgreSQL persistence; ignored, never committed.
DATA_DIR=.data/postgres
# Generate independently: openssl rand -hex 32. Encrypts user Plaid credentials and Item tokens.
# Preserve this key; rotating it requires migrating all existing ciphertext.
TOKEN_ENCRYPTION_KEY=
# Each user adds their own Client ID + Sandbox secret inside Connections.
# No shared PLAID_CLIENT_ID or PLAID_SECRET is needed by the application.
# Vercel Cron authenticates the resumable worker with this independent random secret (32+ characters).
CRON_SECRET=
# Enable on Vercel after configuring the encryption key, cron secret, and minute schedule.
PLAID_WORKER_ENABLED=false
PLAID_WEBHOOK_URL=
# Register this HTTPS URL in each user's Plaid Dashboard (e.g. https://asset.gtfol.dev/plaid/oauth).
PLAID_WEB_REDIRECT_URI=
# HTTPS Universal Link registered in Plaid; requires native signing and Associated Domains.
PLAID_IOS_REDIRECT_URI=
# Production remains disabled in code in this release.
